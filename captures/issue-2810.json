   "event": "gossip",
   "isObject": null,
   "mapID": 1420,
   "name": "Deathguard Cyrus",
   "npc": "1746",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Rand Rhobart is fairly good at skinning felbats and the like.  You can find him at a camp along the road to the southeast of Brill.  Take the road southeast out of town and then head east at the intersection.",
   "time": 1793838016,
   "title": null,
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
  "1746|5d6f0b28": {
