  "1746|25df7842": {
   "build": "70790",
   "class": "Mage",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1420,
   "name": "Deathguard Cyrus",
   "npc": "1746",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Somewhere to fly to?  You'll need to go to the Undercity for that!  Go south on the road out of town, then southwest to the Ruins of Lordaeron.  You can catch the elevator down to the Undercity from the back of the ruins and once there ask an Undercity Guardian for more specific directions.",
   "time": 1793838355,
