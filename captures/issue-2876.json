   "mapID": 1420,
   "name": "Eleanor Shackleton",
   "npc": "265812",
   "questID": 97960,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Being able to skillfully harvest the skins and hides of fallen beasts is one of the more valuable skills an adventurer can possess.\r\n\r\nI reckon I know someone that can teach you how to craft a Camp Chair for your camp. Sometimes it's important to just take a load off, and you can use some of those hides you've gathered to make a comfy chair to sit in. A bit of relaxation can help ensure that you are at your peak condition and can strike where it counts the next time you find yourself in a dust-up.",
   "time": 1793874532,
   "title": "Camping 101: Skinning",
   "wanted": null,
   "zone": "Tirisfal Glades"
  }
 },
