   "name": "Novice Elreth",
   "npc": "1661",
   "questID": 376,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Do try your best to keep yourself unharmed until I get you some armor.",
   "time": 1791639248,
   "title": "The Damned",
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
  "3902-progress": {
   "build": "70374",
   "class": "Warlock",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1420,
   "name": "Deathguard Saltain",
