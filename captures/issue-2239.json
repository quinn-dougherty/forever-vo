  "98389-accept": {
   "build": "70374",
   "class": "Warlock",
   "differs": true,
   "event": "accept",
   "isObject": null,
   "mapID": 1420,
   "name": "Aramis Hammerhand",
   "npc": "244808",
   "questID": 98389,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Greetings, $c. Yes, I am a paladin. Not even death can stop the Light.\r\n\r\nThis is something my kind have in common with all Forsaken--we have overcome what the living view as their end. However, some even among our own fear us; they suspect we will smite them as some monstrosity.\r\n\r\nIn truth, our relationship with undeath is complex, but I am not here to hurt our own. Help me show the others this. Venture to Night's Web Hollow to the northwest and free the freshly raised fools trapped by the spiders there.",
   "time": 1791639261,
   "title": "A Light in the Darkness",
   "wanted": true,
   "zone": "Tirisfal Glades"
  }
 },
