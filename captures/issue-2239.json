   "name": "Venya Marthand",
   "npc": "5667",
   "questID": 1470,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Your power is little now, though I suspect already you sense the possibilities.\n\nEven the dead might feel alive, with that power coursing through us.",
   "time": 1791638398,
   "title": "Piercing the Veil",
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
  "3099-progress": {
   "build": "70374",
   "class": "Warlock",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1420,
   "name": "Maximillion",
   "npc": "2126",
   "questID": 3099,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "I bid you welcome, brother. I knew you would come. It was only a matter of time.\n\nWhat I said interested you, didn't it? I hit a chord... something inside you knew what I claimed was truth. Good.\n\nKnow this though: I am no traitor to Sylvanas. If anything, she would appreciate my claims considering it was her own beliefs that has put the Forsaken in the position it is now.",
   "time": 1791638391,
   "title": "Tainted Scroll",
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
  "376-progress": {
   "build": "70374",
   "class": "Warlock",
   "differs": null,
   "event": "progress",
   "isObject": null,
