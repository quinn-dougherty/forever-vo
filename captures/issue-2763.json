  "251523|191d4b60": {
   "build": "70790",
   "class": "Druid",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 2521,
   "name": "Constable Aonda",
   "npc": "251523",
   "questID": null,
   "race": "High Order Skyborne",
   "sex": "m",
   "source": "community",
   "text": "More than I'd like, I'm afraid. We've been harassed by a group of bandits camping out in a cave to the north, and the Al'Aketh cult recently took over Falaath Village to the south of us. I trust every peacekeeper and citizen here, but we are far too few to keep the village secure. \r\n\r\nIf the cult decides to continue their expansion here, there's little we can do to stop them.",
   "time": 1793864780,
   "title": null,
   "wanted": null,
   "zone": "Zephras Isle"
  },
  "251903|777ae0ec": {
   "build": "70790",
   "class": "Druid",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 2521,
   "name": "Rathiril Sunlance",
   "npc": "251903",
   "questID": null,
   "race": "High Order Skyborne",
   "sex": "m",
   "source": "community",
   "text": "Hello there, young $c. I am Rathiril Sunlance and I am an elder Magister of the High Order here on Zephras Isle. It's always good to see bright-eyed young shen'dorei, ready to do their duty in service to their homeland.\r\n\r\nDon't let this dusty old mage hold you up, however. No doubt you've got many adventures to see to. Feel free to stop by later if you'd like to speak more.",
   "time": 1793864920,
   "title": null,
   "wanted": null,
   "zone": "Zephras Isle"
  },
  "251905|48ad85dc": {
   "build": "70790",
