   "npc": "251905",
   "questID": null,
   "race": "High Order Skyborne",
   "sex": "m",
   "source": "community",
   "text": "Ho there, traveler! New to town? Well, once you get settled in, come see me if you'd like some work. I've been working overtime preparing for the Festival of Winds and I'll take all the help I can get keeping the larders full!",
   "time": 1793864601,
   "title": null,
   "wanted": null,
   "zone": "Zephras Isle"
  },
