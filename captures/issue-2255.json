   "npc": "3033",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Welcome, my brother.  If you are here to train, then I would be delighted to teach you.\n\nIt never hurts to reaffirm one's place within what I like to call the Great Balance.  As preservers of this balance, we must strive to continually keep our minds clear and our hearts strong.  Training helps us in this regard.",
   "time": 1792087475,
   "title": null,
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "3310|cc0cf280": {
