  },
  "91209-complete": {
   "build": "70374",
   "class": "Paladin",
   "differs": null,
   "event": "complete",
   "isObject": null,
   "mapID": 1420,
   "name": "Shari Stilwell",
   "npc": "246152",
   "questID": 91209,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Welcome aboard, $c. It's always encouraging to see more of our number roaming these lands. There are many here in Brill in need of assistance from adventurers such as yourself. Seek employment and grow stronger in the light. Return to me whenever you need training. \r\n\r\nWhen you've proven yourself to myself and the people of Brill, I will provide guidance for the next leg of your journey.\r\n\r\nGo with the light, $c.",
   "time": 1791986275,
   "title": "Continue Your Training",
   "wanted": true,
   "zone": "Tirisfal Glades"
  },
  "99144-accept": {
   "build": "70374",
   "class": "Paladin",
   "differs": true,
   "event": "accept",
   "isObject": null,
   "mapID": 1420,
   "name": "Bareth Dawnstone",
   "npc": "275954",
   "questID": 99144,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Light bless you for finding me. I was on my way from Bandarion Keep to deliver a message to Shari Stilwell in Brill when these monsters captured me. They wield the Light with a hatred in their hearts that makes what's left of my blood seethe. It goes against all we stand for!\r\n\r\n<Bareth Dawnstone steadies himself.>\r\n\r\nOur ranks are thin. If you would aid me in escaping this place, I would be forever grateful.",
   "time": 1791985888,
   "title": "Seeking Refuge",
   "wanted": null,
   "zone": "Crusader's Outpost"
  }
 },
