   "name": "Michael Garrett",
   "npc": "4551",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "How may I be of service?",
   "time": 1793885641,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4552|0c543544": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Eunice Burch",
   "npc": "4552",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Cooking is a life long pursuit and I see we share the same passion!",
   "time": 1793885950,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4556|3dfe0528": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Gordon Wendham",
   "npc": "4556",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Greetings, and welcome.  I am not very good at smiling, but trust me; I am happy to serve you.",
   "time": 1793885656,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4566|544e5c2b": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Kaelystia Hatebringer",
   "npc": "4566",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Well met, $c.  My advice to you is this: as you travel the world, be wary of magic for it will burn the untrained.",
