  },
  "4608|8fca8484": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Father Lazarus",
   "npc": "4608",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes.",
   "time": 1793886761,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4609|a280bec7": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Doctor Marsh",
   "npc": "4609",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "With Algernon to keep me supplied, I can do all my work here without hunting for a single herb. If I never have to see the wonders of nature again, it won't be too soon.",
   "time": 1793886621,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4611|caaefc10": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
