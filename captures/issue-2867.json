  "10781|cb1093ae": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Royal Overseer Bauhaus",
   "npc": "10781",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "I am an officer of the city, working in the capacity of the Undercity's census.  Since our liberation from the Scourge, we have tried to keep an accurate track of our city's populace.  Through arcane methods and sharpened mental discipline, I am able to access these records.  If you have business with me accordingly, please proceed.  You should know if you do, at any rate.",
   "time": 1793886414,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "11031|826d285c": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Franklin Lloyd",
   "npc": "11031",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "I don't have time for idle gossip, I'm a professional!",
   "time": 1793886576,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "11044|386a9ec7": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Doctor Martin Felben",
   "npc": "11044",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Once, it is true, I was human. What might otherwise be a shortcoming works to our advantage, $N, for I know human weaknesses intimately.",
   "time": 1793886643,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "11049|041039a1": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Rhiannon Davis",
   "npc": "11049",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "How can I share my secrets with a beginner? Try speaking with Victor Ward first.",
   "time": 1793886979,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "11870|3a5c3d7e": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Archibald",
   "npc": "11870",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "I suppose you are here to be trained in the use of a new weapon?  Make it fast, I'm very busy!",
   "time": 1793887453,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "14729|9e055276": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Ralston Farnsley",
   "npc": "14729",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "You there... it is in your best interest to aid the Forsaken during these dire times.  Listen closely, as I dislike repeating myself.\n\nWe currently find ourselves in a dire shortage of cloth.  Bandages and simple textiles are running low, and donations are being accepted to bolster sagging inventories.  While you'll not receive financial compensation - hence what donation means - your aid will not go unnoticed.",
   "time": 1793886994,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "223|23e08fe6": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Dan Golthas",
   "npc": "223",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "When I clawed my way out of the grave, I thought my family would welcome me with open arms. Instead, they drove me from the village, screaming in a language I could no longer understand.",
   "time": 1793886469,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "2492|1c7cd7a4": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Lexington Mortaim",
   "npc": "2492",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "I do not believe you possess the mental acuity to grasp the nature of portal magic.",
   "time": 1793886893,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "272526|bf500b92": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Glix Xizzix",
   "npc": "272526",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Yes, I am the renowned trader who magnanimously fed the uh, starving... children...? ...of the Undercity during the recent war with the Scourge. Yes, I am the visionary businessgob and logistical genius who single-handedly armed the resistance and allowed our Dark Lady to found her nation of smelly corpses... um, I mean, \"Forsaken.\"\r\n\r\nYep, I'm him. Glix Xizzix. I'd be happy to sign an autograph. For a small fee, of course.\r\n\r\nWhat am I doing here running a barbershop, you ask? Well I got one word for you, bub--diversification. You've got to keep your revenue streams diversified!",
   "time": 1793885582,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4551|d37b59d0": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
