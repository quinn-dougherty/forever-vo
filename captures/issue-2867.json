   "npc": "4596",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Want to be a smith? Want to forge blades to gut your foe? Hammers to crush his skull? Aye I can help, and gladly too if there is blood to be shed from it.",
   "time": 1793887434,
