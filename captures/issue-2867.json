  "4588|407a9e4e": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Arthur Moore",
   "npc": "4588",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Before my death, I was a librarian; I had nothing to do with wars and plagues. I never asked to become this. On the other hand, now that my mind is my own again, I'm not about to surrender without a fight.",
   "time": 1793886474,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "4591|a28d29e1": {
