 "quests": {
  "98326-accept": {
   "build": "70790",
   "class": "Warrior",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1426,
   "name": "Gretta Ganter",
   "npc": "8508",
   "questID": 98326,
   "race": "Dwarf",
   "sex": "m",
   "source": "community",
   "text": "Do ye know how hard it is to fish on a frozen lake? My poor husband, Paxton, has been out in the middle of it for days and we barely have a single sack to show fer it.\r\n\r\nWell, we DID have a sack to show fer it. Until the thrice-damned wendigo attacked me and made off with our haul. It'll take us weeks to fish all that back up! If that loudmouth Frosthowl didn't scare 'em all off, anyway.\r\n\r\nDo us a favor and get it back, aye? Drooling brute is hiding somewhere deep in the Grizzled Den to the southeast.",
   "time": 1793841516,
   "title": "Frosthowl",
   "wanted": null,
   "zone": "Dun Morogh"
  }
 },
