  "97936-accept": {
   "build": "70790",
   "class": "Hunter",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1412,
   "name": "Kaga Wildhoof",
   "npc": "265810",
   "questID": 97936,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Being able to skillfully harvest the skins and hides of fallen beasts is one of the more valuable skills an adventurer can possess.\r\n\r\nI reckon I know someone that can teach you how to craft a Camp Chair for your camp. Sometimes it's important to just take a load off, and you can use some of those hides you've gathered to make a comfy chair to sit in. A bit of relaxation can help ensure that you are at your peak condition and can strike where it counts the next time you find yourself in a dust-up.",
   "time": 1793874718,
   "title": "Camping 101: Skinning",
   "wanted": null,
   "zone": "Mulgore"
  },
  "97936-complete": {
   "build": "70790",
   "class": "Hunter",
   "differs": null,
   "event": "complete",
   "isObject": null,
   "mapID": 1412,
   "name": "Yonn Deepcut",
   "npc": "6290",
   "questID": 97936,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "There you have it, you can now craft your very own Camp Chair. Most folk don't care much for camps being set up in the center of town, so you'll need to head into the wilderness if you want to test it out.\r\n\r\nOh, and just remember, no camp is complete without a campfire. You'll need one of those before you start up your camp. Most cooks can teach you to make a fire. If you haven't already, you might want to check in with someone who can train you in the culinary arts to learn the basics.",
   "time": 1793874828,
   "title": "Camping 101: Skinning",
   "wanted": null,
   "zone": "Mulgore"
  }
 },
