 "quests": {
  "2746-progress": {
   "build": "70532",
   "class": "Druid",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1453,
   "name": "Tyrion",
   "npc": "7766",
   "questID": 2746,
   "race": "Night Elf",
   "sex": "f",
   "source": "community",
   "text": "I've been watching Lescovar for a couple weeks now. Trias has never trusted him, but we didn't suspect he was involved in anything to do with the Defias Brotherhood. We were following leads that tied him to the Twilight's Hammer. Either way, he's become more dangerous than this city can deal with, and that's where we come in.\n\nGet me those items and we can put my plan into effect.",
   "time": 1792457413,
   "title": "Items of Some Consequence",
   "wanted": null,
   "zone": "Stormwind City"
  },
  "386-progress": {
   "build": "70532",
   "class": "Druid",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1433,
   "name": "Guard Berton",
   "npc": "859",
   "questID": 386,
   "race": "Night Elf",
   "sex": "f",
   "source": "community",
   "text": "Have you been to Stormwind yet, to The Stockade?  I fear whatever trickery that has kept Targorr the Dread alive for this long will eventually bring about his freedom.  He was sentenced to die, $N, not act as some political pawn on a noble's whim.",
   "time": 1792766904,
   "title": "What Comes Around...",
   "wanted": null,
   "zone": "Redridge Mountains"
  },
  "388-progress": {
   "build": "70532",
   "class": "Druid",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1453,
   "name": "Nikova Raskol",
   "npc": "1721",
   "questID": 388,
   "race": "Night Elf",
   "sex": "f",
   "source": "community",
   "text": "I see you are back, $c.  Have you collected 10 Red Wool Bandanas from those Defias Scum in The Stockade yet?",
