   "isObject": null,
   "mapID": 1453,
   "name": "Clavicus Knavingham",
   "npc": "14722",
   "questID": 7791,
   "race": "Night Elf",
   "sex": "f",
   "source": "community",
   "text": "We are currently accepting donations for wool cloth.  A donation of sixty pieces of wool cloth will net you full recognition by Stormwind for your generous actions.  Our stores are such on wool that we would only need sixty pieces from you total; we should be able to acquire enough from others in the realm to support our drive.\n\nIf you have the sixty pieces of wool cloth on you and are ready to donate them, I'm able to take them from you now.",
   "time": 1792757498,
   "title": "A Donation of Wool",
   "wanted": null,
   "zone": "Stormwind City"
  },
