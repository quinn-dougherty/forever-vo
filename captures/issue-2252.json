  },
  "3429|4e7d06f7": {
   "build": "70374",
   "class": "Druid",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
   "name": "Thork",
   "npc": "3429",
   "questID": null,
   "race": "Tauren",
   "sex": "f",
   "source": "community",
   "text": "Welcome to the Crossroads, $c. My name is Thork--I lead the defenses here in the name of the Warchief.\n\nPlease, feel free to make yourself at home. As long as you mind your business, no one should have any problem with you taking up some space.\n\nThere are many threats to our safety here. If you've already become familiar with the lay of the land, speak to the others here--perhaps they have tasks for you to do.",
   "time": 1792065149,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "3442|ef9d74c5": {
   "build": "70374",
