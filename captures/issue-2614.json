   "name": "Teo Hammerstorm",
   "npc": "257446",
   "questID": 94375,
   "race": "Dwarf",
   "sex": "f",
   "source": "community",
   "text": "Well done! Know this--totems ain't just a mark of yer place among shamans. They're tools, a focus for spells tied to stone, soil, and other elements. As ye grow wiser, more o' the mountain's power will open to ye. The trainers will know when yer ready for more. But for now, take this totem, and let the ground speak through ye.",
   "time": 1792526750,
   "title": "Call of Earth",
   "wanted": true,
   "zone": "Anvilmar"
  },
  "94375-progress": {
   "build": "70450",
   "class": "Shaman",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1426,
   "name": "Teo Hammerstorm",
   "npc": "257446",
   "questID": 94375,
   "race": "Dwarf",
   "sex": "f",
   "source": "community",
   "text": "Ahh, ye've returned. If ye have the stone, it means the mountain's chosen ye true. I'll give ye the totem it promised. But if ye've come empty-handed, off with ye! The path ain't for those who forget their way.",
   "time": 1792526748,
   "title": "Call of Earth",
   "wanted": null,
   "zone": "Anvilmar"
  },
