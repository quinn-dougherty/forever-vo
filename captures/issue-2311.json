   "isObject": null,
   "mapID": 1440,
   "name": "Je'neu Sancrea",
   "npc": "12736",
   "questID": null,
   "race": "Troll",
   "sex": "m",
   "source": "community",
   "text": "The elements speak to us, $c.  They share knowledge that we must learn, and they share secrets that must be kept.",
