   "isObject": null,
   "mapID": 1440,
   "name": "Karang Amakkar",
   "npc": "12757",
   "questID": null,
   "race": "Troll",
   "sex": "m",
   "source": "community",
   "text": "Greeting $c - welcome to the front lines in our conquest of Ashenvale!  If you are looking for something to do, then you've come to the right place.  I'm always looking for able-bodied individuals to help bring glory to the Horde!",
   "time": 1791681088,
   "title": null,
   "wanted": null,
   "zone": "Ashenvale"
  },
