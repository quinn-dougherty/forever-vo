   "name": null,
   "npc": null,
   "page": 1,
   "questID": null,
   "race": "Troll",
   "sex": "m",
   "source": "community",
   "text": "Arbor Tarantula\r\n\r\nOrder: Araneae\r\nClimate: Tropical\r\n\r\nBuilds nests inside of dead and rotting wood. Often found near logging activity, as the tarantula seeks to burrow into the freshly cut stumps.",
   "time": 1791671932,
   "title": "Field Guide",
   "wanted": null,
   "zone": "Tanaris"
  }
