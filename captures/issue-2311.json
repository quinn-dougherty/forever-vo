  "12137|c087faab": {
   "build": "70425",
   "class": "Rogue",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1434,
   "name": "Squibby Overspeck",
   "npc": "12137",
   "questID": null,
   "race": "Troll",
   "sex": "m",
   "source": "community",
   "text": "Slip a little coin into the boss's hand and look what it gets ya. I love my job. Though, if I could find a way to get that little firecracker Snurk reassigned to this port....well, I can't imagine it any better. But I'm betting that you aren't here about my business practices. You're looking for the Zeppelin to Undercity, am I right? Well that's great, because it docks right here behind me. Oh and hey, if you see Snurk, put a good word in for me, would ya?",
   "time": 1791670479,
   "title": null,
   "wanted": null,
   "zone": "Stranglethorn Vale"
  },
  "12736|e3f9a765": {
   "build": "70425",
   "class": "Rogue",
   "differs": null,
