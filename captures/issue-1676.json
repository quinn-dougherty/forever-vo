   "event": "accept",
   "isObject": null,
   "mapID": 1420,
   "name": "Deathguard Billmuth",
   "npc": "257655",
   "questID": 94438,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Falgan and I were sent on a mission to scout out scarlet activity in Venomweb Vale. We managed to sneak close enough to one of their camps to hear about new orders involving an attack on Brill. Before we could decide what to do next, I stepped on a twig and the noise alerted them to us.\r\n\r\nFalgan yelled at me to run, so I ran. By the time I realized he wasn't with me, I was halfway to Brill. That brave idiot probably stayed behind to hold them off for me.\r\n\r\nPlease, find my friend and help him if you can.",
   "time": 1791662838,
   "title": "A Lesson in Divinity",
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
  "95884-accept": {
