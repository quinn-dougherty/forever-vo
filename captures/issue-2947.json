   "npc": null,
   "page": 2,
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "should be gathered about the organization of the $r in Brill.\r\n\r\nCaptain Vachon, there appears to be increased movement by the $r near the northern tower. This insurgence must be quickly and decisively dealt with.\r\n\r\nCaptain Melrose, there are concerns about the level of organization of the $r near the borders of the Plaguelands. A fresh group of men will be dispatched to your position in the coming weeks.\r\n\r\nGlory under the Light",
   "time": 1793894524,
   "title": "Scarlet Crusade Documents",
   "wanted": null,
   "zone": "Tirisfal Glades"
  },
