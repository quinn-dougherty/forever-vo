  "3216|13f1d3f9": {
   "build": "70338",
   "class": "Warrior",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1454,
   "name": "Neeru Fireblade",
   "npc": "3216",
   "questID": null,
   "race": "Orc",
   "sex": "m",
   "source": "community",
   "text": "Listen closely to what you are told and do not quickly trust, or distrust.  For even friends serve their own ends, $c.\n\nOur great Warchief knows this, and to prove that there are warlocks within the Horde who do not wish to destroy it from within or gain control over it, I have volunteered to aid our young leader in anyway I can.",
   "time": 1791640859,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
  "3310|cc0cf280": {
