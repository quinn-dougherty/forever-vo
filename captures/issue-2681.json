  "3352|08830bac": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1454,
   "name": "Ormak Grimshot",
   "npc": "3352",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
   "time": 1792216382,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
  "3352|fd7e1800": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1454,
   "name": "Ormak Grimshot",
   "npc": "3352",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "I have much knowledge to impress upon you, $c. You must learn to hunt with honor.",
   "time": 1792216380,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
  "3365|0443423e": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1454,
   "name": "Karolek",
   "npc": "3365",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "The twists and turns of Orgrimmar are designed to thwart invaders. Can you imagine how quickly one of those puny gnomes would get lost in here? Ha! If it was lucky, I'd track it down and keep it as a pet.",
   "time": 1792216183,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
  "3387|da8a5dad": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
   "name": "Jorn Skyseer",
   "npc": "3387",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Although we call this land the Barrens, to one who knows where to look this place teems with life.",
   "time": 1792377496,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "3407|2a1798f1": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1454,
   "name": "Sian'dur",
   "npc": "3407",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Come learn the ways of the $c. Pride, honor, and tradition.",
   "time": 1792216300,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
  "3429|4e7d06f7": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
   "name": "Thork",
   "npc": "3429",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Welcome to the Crossroads, $c. My name is Thork--I lead the defenses here in the name of the Warchief.\n\nPlease, feel free to make yourself at home. As long as you mind your business, no one should have any problem with you taking up some space.\n\nThere are many threats to our safety here. If you've already become familiar with the lay of the land, speak to the others here--perhaps they have tasks for you to do.",
   "time": 1792217369,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "3433|4ec00f6f": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
   "name": "Tatternack Steelforge",
   "npc": "3433",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "The Warchief has instructed me to study all kinds of weapons and armor. He has sent me here to the hub of both the tauren and orc cultures in the Barrens to meet as many travelers as possible, and to learn about the cultures of the Barrens.\n\nHe feels there's something to be learned from even the most pathetic of cultures... like the quilboar or centaur.",
   "time": 1792378180,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "3703|c3a4816f": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
   "name": "Krulmoo Fullmoon",
   "npc": "3703",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Have you come for further training? Shake the dust of the road from your garments, then, and let us get to work.",
   "time": 1792377514,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "3704|7fc65be9": {
   "build": "70532",
