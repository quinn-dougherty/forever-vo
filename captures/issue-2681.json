   "npc": "3704",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "Welcome to our tent. May I assist you?",
   "time": 1792377656,
   "title": null,
   "wanted": null,
   "zone": "The Barrens"
  },
  "6491|22357dc5": {
   "build": "70532",
   "class": "Hunter",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1413,
