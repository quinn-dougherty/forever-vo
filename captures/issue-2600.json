  },
  "251991|8173c391": {
   "build": "70450",
   "class": "Druid",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 2521,
   "name": "Taleen Shimmerthread",
   "npc": "251991",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "The clothcraft of the Shen'dorei is a harmonious imitation of the flowing, carefree currents of the winds. While the spirits have left us, and I know not when I may see them dance once more... I find great comfort in my art, if only as a distraction.\r\n\r\nI can teach you to work the cloth as well, if you'd like to learn?",
   "time": 1792525347,
   "title": null,
   "wanted": null,
   "zone": "Zephras Isle"
  },
  "251993|453a25ae": {
