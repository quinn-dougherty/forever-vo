   "isObject": null,
   "mapID": 2521,
   "name": "Teeri Wellwind",
   "npc": "251906",
   "questID": null,
   "race": "Windshaper Skyborne",
   "sex": "f",
   "source": "community",
   "text": "I'm in charge of Shen'dar Village operations, and there's a lot of things to keep track of around here. Between bandits, cultists, and other random incidents that pop up, keeping this village afloat is a lot of work.",
   "time": 1792525216,
   "title": null,
