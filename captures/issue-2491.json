   "isObject": null,
   "mapID": 1456,
   "name": "Thrag Stonehoof",
   "npc": "10278",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Karn says we need to listen to the spirits of the forge and of the steel, that they will guide us. I hear nothing but a ringing in my ears. Here, take a hammer and let us try to hear the spirits together.",
   "time": 1791989846,
   "title": null,
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "10278|af34ad47": {
   "build": "70450",
   "class": "Warrior",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1456,
   "name": "Thrag Stonehoof",
   "npc": "10278",
   "questID": null,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "I guess the spirits like you better than me, I still have not heard their call but you seem to have gathered their lessons well. Go speak to Karn, he will be excited to see one who hears them as he does.",
   "time": 1792052619,
   "title": null,
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "11869|49ff395c": {
