  "14729|9e055276": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Ralston Farnsley",
   "npc": "14729",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "You there... it is in your best interest to aid the Forsaken during these dire times.  Listen closely, as I dislike repeating myself.\n\nWe currently find ourselves in a dire shortage of cloth.  Bandages and simple textiles are running low, and donations are being accepted to bolster sagging inventories.  While you'll not receive financial compensation - hence what donation means - your aid will not go unnoticed.",
   "time": 1793904043,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "15350|44b49612": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Horde Warbringer",
   "npc": "15350",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "War is upon us, $N.  It's time for every member of the Horde to answer the call and join the fight against the cowardly Alliance.",
   "time": 1793906368,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "2425|7dca81fc": {
   "build": "70790",
   "class": "Priest",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1458,
   "name": "Varimathras",
   "npc": "2425",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "Do not presume to speak to me as though you are my equal, $c. Sylvanas is my queen, and I will do as she bids.\n\nIf you do not show the proper respect, I assure you, we can find a more than suitable place for you in the Nether.\n\nBut there is no reason we cannot have words if you wish to aid the Dark Lady...",
   "time": 1793906357,
   "title": null,
   "wanted": null,
   "zone": "Undercity"
  },
  "246389|8e0ab317": {
