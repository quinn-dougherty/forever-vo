   "npc": "12656",
   "questID": null,
   "race": "High Order Skyborne",
   "sex": "f",
   "source": "community",
   "text": "On the northern dock, you can board a ship that will carry you to Rut'theran Village and Darnassus. From the southern dock, you can find passage across the Great Sea to Menethil Harbor on Khaz Modan, and onwards to Southshore in Hillsbrad Foothills. If you head to the western dock, you can board a ship setting sail for Stormwind.\r\n\r\nSafe journeys to you!",
   "time": 1792338668,
   "title": null,
   "wanted": null,
   "zone": "Darkshore"
  },
  "1347|0624ab70": {
   "build": "70450",
