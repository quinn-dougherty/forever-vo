  },
  "7999|ccf70497": {
   "build": "70450",
   "class": "Mage",
   "differs": null,
   "event": "gossip",
   "isObject": null,
   "mapID": 1457,
   "name": "Tyrande Whisperwind",
   "npc": "7999",
   "questID": null,
   "race": "High Order Skyborne",
   "sex": "f",
   "source": "community",
   "text": "It pleases me greatly to at last meet one of your people. I've heard much of the shen'dorei and your long history, and I am glad to see our cousins return home to Kalimdor at long last.\r\n\r\nI confess that our people have a... complicated relationship with the highborne. Some amongst the night elves are quick to distrust those of highborne descent such as those in your High Order. However, you have my assurance that you will be shown the utmost respect while a guest in our city.\r\n\r\nPlease, make yourself at home here. I'd encourage you to explore and familiarize yourself with our culture. It is, after all, your culture as well in a way.",
   "time": 1792339247,
   "title": null,
   "wanted": null,
   "zone": "Darnassus"
  }
