  "97933-accept": {
   "build": "70790",
   "class": "Shaman",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1412,
   "name": "Kaga Wildhoof",
   "npc": "265810",
   "questID": 97933,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Looks to me like you've gained some skill in herbalism. Picking flowers isn't just for dilly-dallying, you know. It can be useful... and profitable.\r\n\r\nI reckon I know someone that can teach you how to craft an Incense Candle for your camp. High spirits are a key component to keeping healers and spellcasters in the fight, and an Incense Candle can provide a boost that magic users will surely appreciate.",
   "time": 1793843291,
   "title": "Camping 101: Herbalism",
   "wanted": null,
   "zone": "Mulgore"
  },
  "97933-progress": {
   "build": "70790",
   "class": "Shaman",
   "differs": null,
   "event": "progress",
   "isObject": null,
   "mapID": 1456,
   "name": "Komin Winterhoof",
   "npc": "3013",
   "questID": 97933,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Yes, I can teach you.",
   "time": 1793844298,
   "title": "Camping 101: Herbalism",
   "wanted": null,
   "zone": "Thunder Bluff"
  },
  "97936-accept": {
   "build": "70790",
   "class": "Shaman",
   "differs": null,
   "event": "accept",
   "isObject": null,
   "mapID": 1412,
   "name": "Kaga Wildhoof",
   "npc": "265810",
   "questID": 97936,
   "race": "Tauren",
   "sex": "m",
   "source": "community",
   "text": "Being able to skillfully harvest the skins and hides of fallen beasts is one of the more valuable skills an adventurer can possess.\r\n\r\nI reckon I know someone that can teach you how to craft a Camp Chair for your camp. Sometimes it's important to just take a load off, and you can use some of those hides you've gathered to make a comfy chair to sit in. A bit of relaxation can help ensure that you are at your peak condition and can strike where it counts the next time you find yourself in a dust-up.",
   "time": 1793843243,
   "title": "Camping 101: Skinning",
   "wanted": null,
   "zone": "Mulgore"
  }
 },
