   "name": "Karus",
   "npc": "3309",
   "questID": null,
   "race": "Orc",
   "sex": "m",
   "source": "community",
   "text": "Besides the Grunts outside, my brothers and I fought at the battle of Hyjal. Any who seek to steal from the bank must face us first.",
   "time": 1792185709,
   "title": null,
   "wanted": null,
   "zone": "Orgrimmar"
  },
  "3309|6b36598f": {
   "build": "70450",
