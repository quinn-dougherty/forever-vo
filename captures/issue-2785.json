   "npc": "4605",
   "questID": null,
   "race": "Undead",
   "sex": "m",
   "source": "community",
   "text": "You are not trying to kill the anvil with your hammer, you are trying to create a weapon to kill your foes with. Let me show you what you are doing wrong.",
